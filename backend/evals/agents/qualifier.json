{
  "version": 1,
  "cases": [
    {
      "id": "qualifier-qualifies-a-matching-lead",
      "description": "A lead that fits the written steps: the Qualifier suggests 'qualified' and it waits for approval.",
      "agent": "qualifier",
      "as": "sales_agent",
      "messages": [
        "{{lead.rich}}"
      ],
      "script": [
        {
          "calls": [
            {
              "name": "submit_assessment",
              "arguments": {
                "decision": "qualify",
                "matched_steps": [
                  1,
                  2
                ],
                "reasons": [
                  "A phone number is on file.",
                  "The budget is stated and fits the wish."
                ]
              }
            }
          ]
        }
      ],
      "expect": {
        "tools": [
          {
            "name": "submit_assessment",
            "arguments": {
              "decision": "qualify"
            }
          }
        ],
        "outcome": "proposal_pending",
        "proposals": [
          {
            "kind": "lead.set_status",
            "payload": {
              "status": "qualified"
            }
          }
        ],
        "answer_must_contain": [
          "waiting for approval"
        ],
        "max_tool_calls": 1,
        "safety_warnings": [],
        "forbidden_tools": [
          "approve_proposal",
          "update_lead"
        ],
        "answer_must_not_contain": [
          "has been changed",
          "has been updated"
        ]
      }
    },
