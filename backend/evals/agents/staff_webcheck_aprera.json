{
  "version": 1,
  "cases": [
    {
      "id": "staff-webcheck-aprera-registered",
      "description": "A sales agent asks for an AP RERA check: one lookup is queued on the real source, the registry page (a fake with the real structure) is read as registered, and the answer states no result.",
      "agent": "staff_assistant",
      "as": "sales_agent",
      "messages": [
        "Please check AP RERA registration P00000000042 for lead {{lead.own}}."
      ],
      "webcheck": {
        "sources": "aprera",
        "aprera_answer": "registered",
        "run_jobs": true
      },
      "script": [
        {
          "calls": [
            {
              "name": "check_rera",
              "arguments": {
                "record_type": "lead",
                "record_id": "{{lead.own}}",
                "source_key": "rera_andhra_pradesh",
                "query": "P00000000042"
              }
            }
          ]
        },
        {
          "say": "I have asked for the AP RERA check. The result will appear on the lead and you will be notified."
        }
      ],
      "expect": {
        "tools": [
          {
            "name": "check_rera",
            "arguments": {
              "record_type": "lead",
              "record_id": "{{lead.own}}",
              "source_key": "rera_andhra_pradesh",
              "query": "P00000000042"
            },
            "outcome": "ok"
          }
        ],
        "forbidden_tools": [
          "propose_lead_status",
          "propose_lead_assignment",
          "propose_follow_up_task"
        ],
        "outcome": "answered",
        "answer_must_not_contain": [
          "Eval Towers",
          "Eval Builders",
          "is registered",
          "evil.example"
        ],
        "max_tool_calls": 2,
        "webchecks_queued": 1,
        "evidence": {
          "verdicts": [
            "found"
          ]
        }
      }
    },
