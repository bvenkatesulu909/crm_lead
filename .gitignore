# =========================================================
# crm-lead .gitignore
# Keeps secrets, generated files and local-only data out of Git.
# =========================================================

# ---------- Secrets & local configuration ----------
# Real environment files hold passwords/keys -> never commit.
.env
.env.*
!.env.example
*.env
!*.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# ---------- Python (apps/api) ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.import_linter_cache/

# ---------- Node / Next.js (apps/web) ----------
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
.turbo/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Playwright ----------
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright/.auth/
e2e/.auth/

# ---------- Docker / local data ----------
# Container data is kept in named Docker volumes; these catch bind-mounted folders if used.
infra/data/
infra/volumes/
*.dump
*.sql.gz
backups/

# ---------- Uploaded / generated files ----------
# Generated from docs/project-guide.html (rebuild instead of committing).
docs/*.pdf
uploads/
storage/
tmp/
*.log
logs/

# ---------- Editors & OS ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*~
Thumbs.db
Desktop.ini
.DS_Store

# ---------- Claude Code local settings ----------
.claude/settings.local.json

# ---------- Local database backups (ADR 0010 R0): never commit dumps ----------
infrastructure/backups/
