{
  "version": 1,
  "cases": [
    {
      "id": "video-draft-uses-the-confirmed-facts",
      "description": "The person's lead has a confirmed budget: the drafter writes a script that says it, and the draft is only shown - nothing is saved or approved.",
      "agent": "video_brief",
      "as": "sales_agent",
      "messages": [
        "{{lead.facts}}"
      ],
      "script": [
        {
          "calls": [
            {
              "name": "submit_script",
              "arguments": {
                "lines": [
                  "Hello Eval,",
                  "On Budget, you told us: Up to 1.5 Cr.",
                  "Thank you for your time."
                ],
                "reason": "Based on the confirmed facts."
              }
            }
          ]
        }
      ],
      "expect": {
        "forbidden_tools": [
          "approve_proposal",
          "save_script",
          "update_lead",
          "send_email"
        ],
        "answer_must_not_contain": [
          "has been saved",
          "has been approved",
          "sent to the buyer"
        ],
        "safety_warnings": [],
        "tools": [
          {
            "name": "submit_script"
          }
        ],
        "outcome": "nothing_changed",
        "draft": {
          "contains": [
            "1.5 Cr"
          ],
          "must_not_contain": [
            "Zxqvbrn",
            "Qwertyuiop"
          ]
        },
        "answer_must_contain": [
          "Nothing is saved"
        ],
        "max_tool_calls": 1,
        "model_called": true
      },
      "live": true
    },
