# Example configuration for the crm-lead API.
# Copy to .env (which Git ignores) and adjust:   copy .env.example .env
# This file must only ever contain non-secret example values.

# Name reported by the health check and in logs.
CRM_APP_NAME=crm-lead-api

# development | test | production
CRM_ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
CRM_LOG_LEVEL=INFO

# Show interactive API docs at /docs. Set to false in production.
CRM_DOCS_ENABLED=true

# Browser origins allowed to call the API (CORS). Comma-separated, exact scheme://host:port,
# no trailing slash. "*" is rejected on purpose.
CRM_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database (PostgreSQL in Docker, see infrastructure/) ---
# Replace <app-password> / <owner-password> with the CRM_DB_APP_PASSWORD / CRM_DB_OWNER_PASSWORD
# values from infrastructure/.env. These URLs contain passwords, so they belong in .env only.
# Used by the running API: the restricted app role (cannot change the schema).
CRM_DATABASE_URL=postgresql+psycopg://crm_app:<app-password>@127.0.0.1:5432/crm
# Used by Alembic migrations: the schema owner role.
CRM_MIGRATION_DATABASE_URL=postgresql+psycopg://crm_owner:<owner-password>@127.0.0.1:5432/crm
# Used only by tests (tests/db/). Must point at a database whose name ends in _test,
# because the tests erase and rebuild it. Leave unset to skip database tests.
CRM_TEST_DATABASE_URL=postgresql+psycopg://crm_app:<app-password>@127.0.0.1:5432/crm_test
CRM_TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://crm_owner:<owner-password>@127.0.0.1:5432/crm_test

# --- Authentication (Keycloak, see infrastructure/ and docs/auth.md) ---
# Access tokens must come from exactly this issuer and name this audience. Required.
CRM_OIDC_ISSUER=http://localhost:8080/realms/crm
CRM_OIDC_AUDIENCE=crm-api
# Optional: defaults to <issuer>/protocol/openid-connect/certs
# CRM_OIDC_JWKS_URL=
# Only for tests/db/test_keycloak_integration.py (real login). Copy CRM_WEB_CLIENT_SECRET and
# CRM_DEV_USER_PASSWORD from infrastructure/.env. Leave unset to skip those tests.
CRM_TEST_KEYCLOAK_WEB_CLIENT_SECRET=<web-client-secret>
CRM_TEST_KEYCLOAK_USER_PASSWORD=<dev-user-password>

# --- User administration (ADR 0004) ---
# Secret of the Keycloak client "crm-user-admin": copy CRM_USER_ADMIN_CLIENT_SECRET from
# infrastructure/.env. Without it, creating/inviting users answers 503 (everything else works).
CRM_KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
# Where invited people land after setting their password.
CRM_WEB_APP_URL=http://localhost:3000

# --- AI assistant (ADR 0003) ---
# Your Anthropic API key (https://console.anthropic.com). Keep it ONLY in .env, never in code,
# chat or screenshots. Without it the assistant is shown as "not available".
CRM_ANTHROPIC_API_KEY=
# Only for user-level keys (sk-ant-usr-...): the workspace ID from console.anthropic.com
# (Settings -> Workspaces), e.g. wrkspc_01ABC... Not needed for workspace keys (sk-ant-api...).
CRM_ANTHROPIC_WORKSPACE_ID=
# Claude model used by the assistant.
CRM_ASSISTANT_MODEL=claude-opus-5-5
# Limits: messages per customer per hour, tool calls per answer.
CRM_ASSISTANT_MESSAGES_PER_HOUR=30
CRM_ASSISTANT_MAX_TOOL_ROUNDS=6

# --- File store (S3-compatible, SeaweedFS locally; ADR 0005) ---
# Copy FILES_S3_ACCESS_KEY / FILES_S3_SECRET_KEY from infrastructure/.env. Without them,
# storing files (e.g. quote PDFs) answers 503; everything else works.
CRM_FILES_S3_ENDPOINT=127.0.0.1:8333
CRM_FILES_S3_SECURE=false
CRM_FILES_S3_ACCESS_KEY=change-me
CRM_FILES_S3_SECRET_KEY=change-me
CRM_FILES_S3_BUCKET=crm-files

# --- Outgoing e-mail (SMTP; ADR 0005) ---
# Locally Mailpit catches every message (inbox: http://localhost:8025). Nothing leaves this computer.
CRM_SMTP_HOST=127.0.0.1
CRM_SMTP_PORT=2525
CRM_MAIL_FROM=CRM <no-reply@crm.localhost>
# Only for a real mail server later:
# CRM_SMTP_USERNAME=
# CRM_SMTP_PASSWORD=
# CRM_SMTP_STARTTLS=true

# --- Background worker (python -m app.worker; ADR 0005) ---
# CRM_WORKER_POLL_SECONDS=2
# CRM_WORKER_MAX_ATTEMPTS=5

# --- Knowledge-base embeddings (ADR 0010; local, no cloud calls) ---
# The ONNX model is downloaded on first use and cached locally.
CRM_EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
CRM_EMBEDDINGS_DIMENSIONS=384
# Optional: where downloaded model files are cached (empty = fastembed default).
# CRM_EMBEDDINGS_CACHE_DIR=

# Optional database pool tuning (defaults shown).
# CRM_DB_POOL_SIZE=5
# CRM_DB_MAX_OVERFLOW=10
# CRM_DB_STATEMENT_TIMEOUT_MS=15000
