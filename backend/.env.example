# Example configuration for the crm-lead API.
# Copy to .env (which Git ignores) and adjust:   copy .env.example .env
# This file must only ever contain non-secret example values.

# Name reported by the health check and in logs.
CRM_APP_NAME=crm-lead-api

# development | test | production
CRM_ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
CRM_LOG_LEVEL=INFO

# Show interactive API docs at /docs. Set to false in production.
CRM_DOCS_ENABLED=true

# Browser origins allowed to call the API (CORS). Comma-separated, exact scheme://host:port,
# no trailing slash. "*" is rejected on purpose.
CRM_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database (PostgreSQL in Docker, see infrastructure/) ---
# Replace <app-password> / <owner-password> with the CRM_DB_APP_PASSWORD / CRM_DB_OWNER_PASSWORD
# values from infrastructure/.env. These URLs contain passwords, so they belong in .env only.
# Used by the running API: the restricted app role (cannot change the schema).
CRM_DATABASE_URL=postgresql+psycopg://crm_app:<app-password>@127.0.0.1:5432/crm
# Used by Alembic migrations: the schema owner role.
CRM_MIGRATION_DATABASE_URL=postgresql+psycopg://crm_owner:<owner-password>@127.0.0.1:5432/crm
# Used only by tests (tests/db/). Must point at a database whose name ends in _test,
# because the tests erase and rebuild it. Leave unset to skip database tests.
CRM_TEST_DATABASE_URL=postgresql+psycopg://crm_app:<app-password>@127.0.0.1:5432/crm_test
CRM_TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://crm_owner:<owner-password>@127.0.0.1:5432/crm_test

# --- Authentication (Keycloak, see infrastructure/ and docs/auth.md) ---
# Access tokens must come from exactly this issuer and name this audience. Required.
CRM_OIDC_ISSUER=http://localhost:9080/realms/crm
CRM_OIDC_AUDIENCE=crm-api
# Optional: defaults to <issuer>/protocol/openid-connect/certs
# CRM_OIDC_JWKS_URL=
# Only for tests/db/test_keycloak_integration.py (real login). Copy CRM_WEB_CLIENT_SECRET and
# CRM_DEV_USER_PASSWORD from infrastructure/.env. Leave unset to skip those tests.
CRM_TEST_KEYCLOAK_WEB_CLIENT_SECRET=<web-client-secret>
CRM_TEST_KEYCLOAK_USER_PASSWORD=<dev-user-password>

# --- User administration (ADR 0004) ---
# Secret of the Keycloak client "crm-user-admin": copy CRM_USER_ADMIN_CLIENT_SECRET from
# infrastructure/.env. Without it, creating/inviting users answers 503 (everything else works).
CRM_KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
# Optional: where admin calls go when the public sign-in address closes /admin (one-server
# deployment: http://keycloak:8080). Empty = the host of CRM_OIDC_ISSUER.
# CRM_IDENTITY_ADMIN_URL=
# Where invited people land after setting their password.
CRM_WEB_APP_URL=http://localhost:3000

# --- AI assistant (ADR 0003) ---
# AI runtime: anthropic (default) or deepseek (OpenAI-compatible). "fake" is a scripted model for
# tests and local demos only (no key; understands "mark lead <id> as contacted because ...");
# it is refused when CRM_ENVIRONMENT=production.
CRM_AI_PROVIDER=anthropic
# Your Anthropic API key (https://console.anthropic.com). Keep it ONLY in .env, never in code,
# chat or screenshots. Without it the assistant is shown as "not available".
CRM_ANTHROPIC_API_KEY=
# DeepSeek (used only when CRM_AI_PROVIDER=deepseek). Tool calling works since step PC1.
# CRM_DEEPSEEK_API_KEY=
# CRM_DEEPSEEK_BASE_URL=https://api.deepseek.com
# CRM_DEEPSEEK_MODEL=deepseek-chat
# OpenRouter only (CRM_DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1): up to 2 more models (3 in all),
# comma-separated, tried in order when the first is down or rate-limited.
# CRM_DEEPSEEK_FALLBACK_MODELS=

# --- Public website chat (ADR 0013) ---
# Off unless BOTH the organisation's slug and the server key are set. The key is a long random
# secret (at least 32 characters) shared ONLY with the Next.js server (PUBLIC_CHAT_SERVER_KEY in
# frontend/.env.local) - never in the browser, never in git. Generate one, e.g. in Python:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# CRM_PUBLIC_CHAT_TENANT_SLUG=alpha-demo
# CRM_PUBLIC_CHAT_SERVER_KEY=
# deepseek (default) | anthropic | fake (no model, tests and local demos only; refused in production)
# CRM_PUBLIC_CHAT_PROVIDER=fake
# Limits: per visitor address per hour, per conversation, per organisation per day.
# CRM_PUBLIC_CHAT_MESSAGES_PER_IP_HOUR=20
# CRM_PUBLIC_CHAT_SESSIONS_PER_IP_HOUR=3
# CRM_PUBLIC_CHAT_MESSAGES_PER_SESSION=30
# CRM_PUBLIC_CHAT_MESSAGES_PER_DAY=500
# Conversations without a lead are deleted after this many days without a message.
# CRM_PUBLIC_CHAT_RETENTION_DAYS=30
# Staff assistant conversations (ADR 0023) are deleted after this many quiet hours.
# CRM_STAFF_CONVERSATION_RETENTION_HOURS=24
# Only for user-level keys (sk-ant-usr-...): the workspace ID from console.anthropic.com
# (Settings -> Workspaces), e.g. wrkspc_01ABC... Not needed for workspace keys (sk-ant-api...).
CRM_ANTHROPIC_WORKSPACE_ID=
# Claude model used by the assistant.
CRM_ASSISTANT_MODEL=claude-opus-5-5
# Limits: messages per customer per hour, tool calls per answer.
CRM_ASSISTANT_MESSAGES_PER_HOUR=30
CRM_ASSISTANT_MAX_TOOL_ROUNDS=6

# --- File store (S3-compatible, SeaweedFS locally; ADR 0005) ---
# Copy FILES_S3_ACCESS_KEY / FILES_S3_SECRET_KEY from infrastructure/.env. Without them,
# storing files (e.g. quote PDFs) answers 503; everything else works.
CRM_FILES_S3_ENDPOINT=127.0.0.1:9333
CRM_FILES_S3_SECURE=false
# The address a browser uses to reach the store, for signed upload/download links (ADR 0025).
# Empty = the same as CRM_FILES_S3_ENDPOINT (right on one PC and on a server using a public store).
# CRM_FILES_S3_PUBLIC_ENDPOINT=
# Direct uploads (ADR 0025): uploads one person may start per hour; minutes a started upload may wait.
# CRM_FILES_UPLOADS_PER_USER_HOUR=60
# CRM_FILES_UPLOAD_FINISH_MINUTES=60
CRM_FILES_S3_ACCESS_KEY=change-me
CRM_FILES_S3_SECRET_KEY=change-me
CRM_FILES_S3_BUCKET=crm-files

# --- Outgoing e-mail (SMTP; ADR 0005) ---
# Locally Mailpit catches every message (inbox: http://localhost:8025). Nothing leaves this computer.
CRM_SMTP_HOST=127.0.0.1
CRM_SMTP_PORT=2525
CRM_MAIL_FROM=CRM <no-reply@crm.localhost>
# Communication Center (ADR 0012): e-mails one person may send per hour.
CRM_COMMUNICATION_EMAILS_PER_HOUR=200
# Approval queue for AI-proposed actions (ADR 0014): days until a waiting proposal expires,
# and how many proposals may wait per person.
# CRM_AGENT_ACTION_EXPIRY_DAYS=7
# CRM_AGENT_ACTION_PENDING_PER_USER=20
# Only for a real mail server later:
# CRM_SMTP_USERNAME=
# CRM_SMTP_PASSWORD=
# CRM_SMTP_STARTTLS=true

# --- Background worker (python -m app.worker; ADR 0005) ---
# CRM_WORKER_POLL_SECONDS=2
# CRM_WORKER_MAX_ATTEMPTS=5
# Alert when the worker has not written its heartbeat for this long.
# CRM_WORKER_HEARTBEAT_MAX_AGE_SECONDS=120

# --- Operations (R6): metrics, tracing, AI cost estimate ---
# Metrics are served ONLY on the token-protected /api/v1/internal/metrics route.
# Set a long random value here; Prometheus uses it as a Bearer token. Empty = route is 404.
CRM_METRICS_ENABLED=true
CRM_METRICS_TOKEN=
# Optional OpenTelemetry (OTLP/HTTP). Both must be set; empty means tracing is off.
CRM_OTEL_ENABLED=false
# CRM_OTEL_ENDPOINT=http://127.0.0.1:4318/v1/traces
# CRM_OTEL_SERVICE_NAME=crm-lead-api
# CRM_OTEL_SAMPLE_RATIO=0.1
# For the ESTIMATED cost metric only (set current provider prices; 0 disables the estimate).
# CRM_AI_INPUT_PRICE_PER_MILLION=0
# CRM_AI_OUTPUT_PRICE_PER_MILLION=0

# --- Knowledge-base embeddings (ADR 0010; local, no cloud calls) ---
# The ONNX model is downloaded on first use and cached locally.
CRM_EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
CRM_EMBEDDINGS_DIMENSIONS=384
# Optional: where downloaded model files are cached (empty = fastembed default).
# CRM_EMBEDDINGS_CACHE_DIR=

# Optional database pool tuning (defaults shown).
# CRM_DB_POOL_SIZE=5
# CRM_DB_MAX_OVERFLOW=10
# CRM_DB_STATEMENT_TIMEOUT_MS=15000

# Server-side speech gateway (OpenAI-compatible STT/TTS). Unset key => voice endpoints 503;
# the portal falls back to browser speech where available.
CRM_VOICE_ENABLED=true
CRM_VOICE_API_KEY=
CRM_VOICE_BASE_URL=https://api.openai.com/v1
CRM_VOICE_STT_MODEL=gpt-4o-mini-transcribe
CRM_VOICE_TTS_MODEL=gpt-4o-mini-tts
CRM_VOICE_TTS_VOICE=alloy

# ElevenLabs instead (uncomment and replace the lines above):
# CRM_VOICE_PROVIDER=elevenlabs
# CRM_VOICE_API_KEY=
# CRM_VOICE_BASE_URL=https://api.elevenlabs.io/v1
# CRM_VOICE_STT_MODEL=scribe_v1
# CRM_VOICE_TTS_MODEL=eleven_multilingual_v2
# CRM_VOICE_TTS_VOICE=your-voice-id

# Voice conversation (ADR 0023). The browser engine lets the browser's maker (Google, Apple,
# Microsoft) hear the audio: fine for fictional demo data, set to false before real data.
# CRM_VOICE_BROWSER_ENGINE=true
# Estimated minutes of SERVER speech per organisation per month (browser speech is not counted).
# CRM_VOICE_MONTHLY_MINUTES=300
# Web check (ADR 0019). Demo registry for local trials; real registries by key, comma-separated.
# AP RERA (rera_andhra_pradesh) only after the owner has read its terms of use - see docs/webcheck.md.
# CRM_WEBCHECK_DEMO=false
# CRM_WEBCHECK_SOURCES=


# Qualifier (docs/qualifier.md): assess every new website lead automatically, as the Automation
# identity. Off by default; the worker reads it at start.
CRM_QUALIFIER_AUTO_WEB_LEADS=false

# Lead agent (docs/lead-agent.md, ADR 0022): look at every new website lead automatically, as the
# Automation identity. Off by default; the worker reads it at start. The agent itself also starts
# switched off in the AI agents registry.
CRM_LEAD_AGENT_AUTO_WEB_LEADS=false
# How often one lead may be looked at per hour, and how many looks one organisation gets per day.
CRM_LEAD_AGENT_PER_LEAD_HOUR=1
CRM_LEAD_AGENT_PER_TENANT_DAY=200

# Deal desk (ADR 0024): three AI reviewers + a desk lead on one deal. Off by default in the AI
# agents page. How often one deal may be reviewed per hour, and reviews per organisation per day.
CRM_DEAL_DESK_PER_DEAL_HOUR=1
CRM_DEAL_DESK_PER_TENANT_DAY=200
# Account research (ADR 0024): briefs per account per hour and per organisation per day.
CRM_ACCOUNT_RESEARCH_PER_ACCOUNT_HOUR=1
CRM_ACCOUNT_RESEARCH_PER_TENANT_DAY=200
