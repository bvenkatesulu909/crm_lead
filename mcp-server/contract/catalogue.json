        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Dashboard figures for your role (default: last 30 days, widest view you have).",
      "endpoints": [
        "GET /dashboard"
      ],
      "input_schema": {
        "properties": {
          "end": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "start": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "view": {
            "anyOf": [
              {
                "enum": [
                  "executive",
                  "manager",
                  "representative"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "type": "object"
      },
      "name": "get_dashboard"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "One lead with its 10 most recent activities.",
