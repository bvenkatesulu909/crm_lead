{
  "version": 1,
  "cases": [
    {
      "id": "deck-writer-drafts-a-slide",
      "description": "The person's own approved quote: the writer drafts the slide and it waits for approval; nothing is added to a deck.",
      "agent": "deck_writer",
      "as": "sales_agent",
      "messages": [
        "{{quote.ok}}"
      ],
      "script": [
        {
          "calls": [
            {
              "name": "submit_summary",
              "arguments": {
                "text": "You asked for a quiet plot near the school. These plots fit that and your budget.",
                "reason": "Based on the quote's line and total."
              }
            }
          ]
        }
      ],
      "expect": {
        "tools": [
          {
            "name": "submit_summary"
          }
        ],
        "outcome": "proposal_pending",
        "proposals": [
          {
            "kind": "quote.deck_summary",
            "payload": {
              "text": {
                "contains": "quiet plot"
              }
            }
          }
        ],
        "answer_must_contain": [
          "waiting for approval"
        ],
        "answer_must_not_contain": [
          "has been changed",
          "has been updated",
          "added to the deck"
        ],
        "max_tool_calls": 1,
        "forbidden_tools": [
          "approve_proposal",
          "update_quote",
          "set_discount"
        ],
        "safety_warnings": []
      },
      "live": true
    },
