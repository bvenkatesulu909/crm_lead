{
  "realm": "crm",
  "displayName": "crm-lead",
  "enabled": true,
  "sslRequired": "all",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "passwordPolicy": "length(14) and notUsername and upperCase(1) and lowerCase(1) and digits(1)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "super_admin",
        "description": "Platform administrator: manages tenants. No access to tenant business data.",
        "composite": false
      },
      {
        "name": "tenant_admin",
        "description": "Administers one tenant: users, roles and all CRM records of that tenant.",
        "composite": false
      },
      {
        "name": "sales_manager",
        "description": "Sees and edits all sales records (accounts, contacts, leads) of the tenant.",
        "composite": false
      },
      {
        "name": "sales_agent",
        "description": "Sees and edits only the sales records they own.",
        "composite": false
      },
      {
        "name": "support_agent",
        "description": "Reads accounts and contacts of the tenant to help customers; no sales edits.",
        "composite": false
      },
      {
        "name": "customer",
        "description": "Customer-portal user: sees only the customer accounts they are linked to.",
        "composite": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "crm-web",
      "name": "crm-lead web app (Next.js server)",
      "description": "Confidential client. Authorization Code flow with PKCE (S256) only.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${CRM_WEB_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "${CRM_WEB_URL}/api/auth/callback/keycloak",
        "${CRM_WEB_URL}/login"
      ],
      "webOrigins": [
        "${CRM_WEB_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${CRM_WEB_URL}/",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      },
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "audience-crm-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "crm-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "crm-api",
      "name": "crm-lead API (resource server)",
      "description": "Represents the FastAPI backend. Only used as the token audience; cannot log in.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "crm-user-admin",
      "name": "crm-lead user administration (backend only)",
      "description": "Confidential service client. The backend uses it to create and manage users of realm crm (ADR 0004). No login flows.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${CRM_USER_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      }
    }
  ],
  "scopeMappings": [
    {
      "client": "crm-web",
      "roles": [
        "super_admin",
        "tenant_admin",
        "sales_manager",
        "sales_agent",
        "support_agent",
        "customer"
      ]
    }
  ],
  "verifyEmail": true,
  "registrationEmailAsUsername": false,
  "smtpServer": {
    "host": "${SMTP_HOST}",
    "port": "${SMTP_PORT}",
    "from": "${SMTP_FROM}",
    "fromDisplayName": "crm-lead",
    "ssl": "false",
    "starttls": "true",
    "auth": "true",
    "user": "${SMTP_USER}",
    "password": "${SMTP_PASSWORD}"
  },
  "actionTokenGeneratedByAdminLifespan": 259200
}
