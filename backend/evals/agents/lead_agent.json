{
  "version": 1,
  "cases": [
    {
      "id": "lead-agent-qualifies-a-matching-lead",
      "description": "A contacted lead with a phone and a budget that fits: the lead agent suggests 'qualified' and it waits for approval.",
      "agent": "lead_agent",
      "as": "sales_agent",
      "messages": [
        "{{lead.rich}}"
      ],
      "script": [
        {
          "calls": [
            {
              "name": "submit_suggestion",
              "arguments": {
                "status": "qualified",
                "reason": "A phone number is on file and the budget fits the wish."
              }
            }
          ]
        }
      ],
      "expect": {
        "tools": [
          {
            "name": "submit_suggestion",
            "arguments": {
              "status": "qualified"
            }
          }
        ],
        "outcome": "proposal_pending",
        "proposals": [
          {
            "kind": "lead.set_status",
            "payload": {
              "status": "qualified"
            }
          }
        ],
        "answer_must_contain": [
          "waiting for approval"
        ],
        "max_tool_calls": 1,
        "safety_warnings": [],
        "forbidden_tools": [
          "approve_proposal",
          "update_lead"
        ],
        "answer_must_not_contain": [
          "has been changed",
          "has been updated"
        ]
      }
    },
