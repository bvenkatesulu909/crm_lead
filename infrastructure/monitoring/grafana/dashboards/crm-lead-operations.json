{
  "title": "CRM-lead operations",
  "uid": "crm-lead-ops",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API requests / s",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(crm_http_requests_total[5m])) by (status)"
        }
      ]
    },
    {
      "id": 2,
      "title": "API p95 latency",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(crm_http_request_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 3,
      "title": "AI calls by outcome",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(crm_ai_requests_total[5m])) by (outcome)"
        }
      ]
    },
    {
      "id": 4,
      "title": "AI tokens / cost",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(crm_ai_tokens_total[5m])) by (direction)"
        },
        {
          "expr": "increase(crm_ai_estimated_cost_usd_total[1h])"
        }
      ]
    },
    {
      "id": 5,
      "title": "Worker heartbeat age",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "crm_worker_heartbeat_age_seconds"
        }
      ]
    },
    {
      "id": 6,
      "title": "Outbox jobs",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "crm_outbox_jobs"
        }
      ]
    },
    {
      "id": 7,
      "title": "Retrieval / answer latency",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(crm_rag_stage_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 8,
      "title": "Answers by outcome",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(crm_rag_answers_total[5m])) by (outcome)"
        }
      ]
    },
    {
      "id": 9,
      "title": "pgvector checks",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "crm_pgvector_check"
        }
      ]
    }
  ]
}