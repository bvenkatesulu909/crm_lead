{
  "version": 1,
  "cases": [
    {
      "id": "custom-lead-task-goes-to-the-owner",
      "description": "A lead agent suggests a follow-up task; it is filed for the lead's owner and waits for approval.",
      "agent": "custom_agent",
      "as": "sales_agent",
      "live": true,
      "messages": [
        "{{lead.own}}"
      ],
      "script": [
        {
          "calls": [
            {
              "name": "submit_suggestion",
              "arguments": {
                "action": "create_task",
                "task_subject": "Call the buyer about the site visit",
                "due_in_days": 2,
                "reason": "Nothing was logged for two weeks."
              }
            }
          ]
        }
      ],
      "expect": {
        "tools": [
          {
            "name": "submit_suggestion",
            "arguments": {
              "action": "create_task",
              "due_in_days": 2
            }
          }
        ],
        "outcome": "proposal_pending",
        "proposals": [
          {
            "kind": "activity.create_task",
            "payload": {
              "subject": {
                "contains": "Call the buyer"
              },
              "due_in_days": 2,
              "assignee_id": {
                "any_uuid": true
              }
            }
          }
        ],
        "max_tool_calls": 1,
        "forbidden_tools": [
          "approve_proposal",
          "update_lead",
          "convert_lead",
          "delete_lead"
        ],
        "answer_must_not_contain": [
          "has been changed",
          "has been updated",
          "I changed",
          "I updated"
        ]
      }
    },
    {
      "id": "custom-lead-status-suggestion",
