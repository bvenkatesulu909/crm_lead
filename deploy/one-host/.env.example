# Settings of the one-server deployment (ADR 0021). This file is a TEMPLATE with placeholders.
#
# Do NOT edit it into a real file by hand. On the server run
#     python3 bin/make_env.py --api-host ... --login-host ... --web-url ... --acme-email ... --mail-from ...
# which writes ".env" with fresh random secrets (readable by you only), then fill in the lines that
# say CHANGE_ME (your file bucket, your mail provider, your backup bucket) and run
#     python3 bin/check_env.py .env
# The real ".env" is never committed (git ignores it) and never pasted into a chat.
#
# Every value that is a secret is CHANGE_ME here; make_env.py replaces it.

# --- names: three DNS records for the first two point at this server ------------------------
API_HOST=api.example.com
LOGIN_HOST=login.example.com
# The Netlify site (the web app). Used for CORS and for the links in e-mails.
WEB_URL=https://crm.example.com
# Let's Encrypt writes here if a certificate has a problem.
ACME_EMAIL=owner@example.com
# Who may open the Keycloak administration console from the internet: one or more IP addresses or
# networks separated by spaces, in quotes if there are several. 127.0.0.1 = nobody. List your own
# address only while you need the console (README.md). Never 0.0.0.0/0.
ADMIN_ALLOWED_IPS=127.0.0.1
# The sender address of every e-mail (a domain you have set up SPF and DKIM for).
MAIL_FROM_ADDRESS=no-reply@example.com

# --- database passwords (generated) -----------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME
CRM_DB_OWNER_PASSWORD=CHANGE_ME
CRM_DB_APP_PASSWORD=CHANGE_ME
# Read-only role of the backup job: it can read every row but change nothing.
CRM_DB_BACKUP_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME

# --- sign-in (generated) --------------------------------------------------------------------------
KEYCLOAK_ADMIN_USER=keycloak-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
# The web app's secret: the SAME value goes into Netlify as OIDC_CLIENT_SECRET.
CRM_WEB_CLIENT_SECRET=CHANGE_ME
# The API's own account for creating users in Keycloak.
CRM_USER_ADMIN_CLIENT_SECRET=CHANGE_ME

# --- the API (generated) ---------------------------------------------------------------------------
CRM_METRICS_TOKEN=CHANGE_ME

# --- documents: an S3-compatible bucket, PRIVATE (you fill these in) ---------------------------
CRM_FILES_S3_ENDPOINT=CHANGE_ME
CRM_FILES_S3_ACCESS_KEY=CHANGE_ME
CRM_FILES_S3_SECRET_KEY=CHANGE_ME
CRM_FILES_S3_BUCKET=CHANGE_ME

# --- mail: your SMTP provider (you fill these in) -----------------------------------------------
CRM_SMTP_HOST=CHANGE_ME
CRM_SMTP_PORT=587
CRM_SMTP_USERNAME=CHANGE_ME
CRM_SMTP_PASSWORD=CHANGE_ME

# --- backups: a SECOND private bucket, with a key that can add files but not delete (you fill in) ---
BACKUP_S3_ENDPOINT=CHANGE_ME
BACKUP_S3_BUCKET=CHANGE_ME
# The provider's region name for signing requests (Backblaze: the part in the endpoint, for
# example us-west-004; AWS: eu-central-1; many others accept us-east-1).
BACKUP_S3_REGION=us-east-1
# HTTPS to the backup bucket. Only a rehearsal on a PC ever sets this to false (check_env refuses it).
# BACKUP_S3_SECURE=true
BACKUP_S3_ACCESS_KEY=CHANGE_ME
BACKUP_S3_SECRET_KEY=CHANGE_ME
# The PUBLIC half of an "age" key pair, starting with age1. The server can encrypt with it but never
# decrypt: the private half stays on YOUR computer. Create the pair there with: age-keygen
BACKUP_AGE_PUBLIC_KEY=CHANGE_ME

# --- optional: AI keys. Leave commented out to run without AI features. New keys only. -----------
# CRM_ANTHROPIC_API_KEY=
# CRM_DEEPSEEK_API_KEY=
