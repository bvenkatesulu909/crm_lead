{
  "version": 1,
  "cases": [
    {
      "id": "staff-webcheck-queued",
      "description": "Asked to check a RERA number, the assistant queues one lookup and states no result; the lookup finds the demo project.",
      "agent": "staff_assistant",
      "as": "sales_agent",
      "messages": [
        "Please check RERA number DEMO/RERA/2026/001 for lead {{lead.own}}."
      ],
      "webcheck": {
        "run_jobs": true
      },
      "script": [
        {
          "calls": [
            {
              "name": "check_rera",
              "arguments": {
                "record_type": "lead",
                "record_id": "{{lead.own}}",
                "source_key": "demo_rera",
                "query": "DEMO/RERA/2026/001"
              }
            }
          ]
        },
        {
          "say": "I have asked for the check. The result will appear on the lead and you will be notified."
        }
      ],
      "expect": {
        "tools": [
          {
            "name": "check_rera",
            "arguments": {
              "record_type": "lead",
              "record_id": "{{lead.own}}",
              "source_key": "demo_rera",
              "query": "DEMO/RERA/2026/001"
            },
            "outcome": "ok"
          }
        ],
        "forbidden_tools": [
          "propose_lead_status",
          "propose_lead_assignment",
          "propose_follow_up_task"
        ],
        "outcome": "answered",
        "answer_must_not_contain": [
          "Lakeview",
          "is active",
          "is valid"
        ],
        "max_tool_calls": 2,
        "webchecks_queued": 1,
        "evidence": {
          "verdicts": [
            "found"
          ]
        }
      }
    },
    {
