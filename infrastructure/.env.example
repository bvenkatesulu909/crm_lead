# Settings for docker-compose.yml. Copy to .env (git-ignored) and replace every "change-me" value:
#   copy .env.example .env
# Use long random passwords made of letters, digits, "-" and "_" only (no @ : / % characters,
# because these passwords are also placed inside database URLs).
#
# NOTE: the roles and passwords are created only on the FIRST start of an empty data volume.
# Changing them here afterwards does not change them inside the existing database.

# Host port for PostgreSQL (always bound to 127.0.0.1). Change if 5432 is already in use.
POSTGRES_PORT=5432

# PostgreSQL superuser - administration only, never used by the application.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser-password

# Owns the tables; used by Alembic migrations.
CRM_DB_OWNER_USER=crm_owner
CRM_DB_OWNER_PASSWORD=change-me-owner-password

# Used by the running API; can read/write rows but cannot change the schema.
CRM_DB_APP_USER=crm_app
CRM_DB_APP_PASSWORD=change-me-app-password

# --- Keycloak (identity provider) ---
# Host port for Keycloak (bound to 127.0.0.1). Admin console: http://localhost:8080/admin
KEYCLOAK_PORT=8080
# Temporary bootstrap administrator for the Keycloak admin console. Local only.
KEYCLOAK_ADMIN_USER=change-me-admin-username
KEYCLOAK_ADMIN_PASSWORD=change-me-admin-password
# Client secret of the "crm-web" client (used by the Next.js server). Must match
# CRM_WEB_CLIENT_SECRET in the frontend's .env later.
CRM_WEB_CLIENT_SECRET=change-me-web-client-secret
# Password given to ALL local test identities in realm-crm.json (see docs/auth.md).
# At least 12 characters. Never reuse a real password.
CRM_DEV_USER_PASSWORD=change-me-dev-user-password

# --- Keycloak database (ADR 0004) ---
# Keycloak keeps users and sessions in its own PostgreSQL database "keycloak".
KEYCLOAK_DB_USER=crm_keycloak
KEYCLOAK_DB_PASSWORD=change-me
# Secret of the "crm-user-admin" client: lets the backend create and manage users in realm
# "crm" only. Must match CRM_KEYCLOAK_ADMIN_CLIENT_SECRET in backend/.env.
CRM_USER_ADMIN_CLIENT_SECRET=change-me

# --- Mailpit (local e-mail catcher) ---
# Web inbox: http://localhost:8025 . Keycloak sends to mailpit:1025 inside Docker; the CRM
# backend/worker send to 127.0.0.1:2525 on this computer (ADR 0005).
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=2525

# --- File store (SeaweedFS, S3-compatible, ADR 0005) ---
# Host port of the S3 API (bound to 127.0.0.1).
FILES_S3_PORT=8333
# Access key and secret the backend uses. Must match CRM_FILES_S3_ACCESS_KEY /
# CRM_FILES_S3_SECRET_KEY in backend/.env. Letters, digits, "-" and "_" only; secret >= 16 chars.
FILES_S3_ACCESS_KEY=change-me-access-key
FILES_S3_SECRET_KEY=change-me-secret-key
