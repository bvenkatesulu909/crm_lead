# Configuration for the crm-lead web app (Next.js). Copy to .env.local (git-ignored):
#   copy .env.example .env.local
# Everything here is read on the SERVER only; none of it is sent to the browser.

# Public URL of this web app (used to build the OIDC redirect URI).
APP_BASE_URL=http://localhost:3000

# FastAPI backend, as reached from the Next.js server.
API_BASE_URL=http://127.0.0.1:8000/api/v1

# Keycloak (see infrastructure/keycloak/realm-crm.json and docs/auth.md).
OIDC_ISSUER=http://localhost:8080/realms/crm
OIDC_CLIENT_ID=crm-web
# Same value as CRM_WEB_CLIENT_SECRET in infrastructure/.env
OIDC_CLIENT_SECRET=<web-client-secret>

# Key that encrypts the session cookie: 32 random bytes, base64url. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=<32-random-bytes-base64url>

# Only for end-to-end tests (Playwright): password of the local test identities, same value as
# CRM_DEV_USER_PASSWORD in infrastructure/.env. Leave empty to skip login-based E2E tests.
E2E_USER_PASSWORD=
